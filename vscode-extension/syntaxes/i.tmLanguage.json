{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "I",
  "scopeName": "source.i",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#intrinsics" },
    { "include": "#capabilities" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#routines" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.i",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.i",
          "match": "#.*$"
        },
        {
          "name": "comment.block.i",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.i",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.i",
              "match": "\\\\(?:[nrt0\"\\\\]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.builtin.i entity.name.function.intrinsic.i",
          "match": "@(out8|in8|out16|in16|out32|in32|load32|store32|load8|store8|load64|store64|cli|sti|hlt|syscall|cpuid|read_msr|write_msr|mfence|clwb)\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "constant.language.capability.i entity.name.tag.i",
          "match": "\\b(hardware_io|raw_memory|interrupt_control|kernel_ring0|host_syscall|all)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.system.i",
          "match": "\\b(system|require|cap|use)\\b"
        },
        {
          "name": "keyword.declaration.routine.i",
          "match": "\\b(routine|kernel_entry)\\b"
        },
        {
          "name": "keyword.declaration.variable.i",
          "match": "\\b(bind|mut)\\b"
        },
        {
          "name": "keyword.control.conditional.i",
          "match": "\\b(branch|otherwise)\\b"
        },
        {
          "name": "keyword.control.loop.i",
          "match": "\\b(cycle|repeat|until)\\b"
        },
        {
          "name": "keyword.control.flow.i",
          "match": "\\b(yield|halt|trap)\\b"
        },
        {
          "name": "keyword.other.contract.i",
          "match": "\\b(verify|atomic|unsafe)\\b"
        },
        {
          "name": "keyword.declaration.type.i",
          "match": "\\b(layout|bitfield)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.i storage.type.i",
          "match": "\\b(b1|b8|b16|b32|b64|b128|u8|u16|u32|u64|i8|i16|i32|i64|void|raw|\\*raw|\\*mut|\\*const)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.binary.i",
          "match": "\\b0b[01_]+(?::(u8|u16|u32|u64|i8|i16|i32|i64|b8|b16|b32|b64))?\\b"
        },
        {
          "name": "constant.numeric.hex.i",
          "match": "\\b0x[0-9a-fA-F_]+(?::(u8|u16|u32|u64|i8|i16|i32|i64|b8|b16|b32|b64))?\\b"
        },
        {
          "name": "constant.numeric.decimal.i",
          "match": "\\b[0-9_]+(?::(u8|u16|u32|u64|i8|i16|i32|i64|b8|b16|b32|b64))?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.checked.i",
          "match": "\\+!|-!|\\*!"
        },
        {
          "name": "keyword.operator.arithmetic.modular.i",
          "match": "\\+%|-%|\\*%"
        },
        {
          "name": "keyword.operator.arithmetic.saturating.i",
          "match": "\\+\\?|-\\?"
        },
        {
          "name": "keyword.operator.bitwise.rotate.i",
          "match": "<<<|>>>"
        },
        {
          "name": "keyword.operator.bitwise.shift.i",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.bitwise.i",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.i",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.i",
          "match": "="
        },
        {
          "name": "punctuation.separator.i",
          "match": ";|,|:|::|->"
        }
      ]
    },
    "routines": {
      "patterns": [
        {
          "match": "\\b(routine|kernel_entry)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.routine.i" },
            "2": { "name": "entity.name.function.i" }
          }
        }
      ]
    }
  }
}
